<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante di obfuscar.xml per la pipeline SINGLE-FILE.
  Offusca il dll nella cartella di BUILD (bin), che poi il bundler single-file inglobera'
  nell'exe. Stesse esclusioni di obfuscar.xml.
-->
<Obfuscator>
  <Var name="InPath" value="src\StreamingDoc.App\bin\Release\net9.0-windows10.0.19041.0\win-x64" />
  <Var name="OutPath" value="src\StreamingDoc.App\bin\Release\net9.0-windows10.0.19041.0\win-x64\_obf" />
  <Var name="KeepPublicApi" value="false" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="false" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="RegenerateDebugInfo" value="false" />

  <AssemblySearchPath path="src\StreamingDoc.App\bin\Release\net9.0-windows10.0.19041.0\win-x64" />

  <Module file="$(InPath)\Nexus Streamer.dll">
    <SkipNamespace name="StreamingDoc.App" />
    <SkipNamespace name="StreamingDoc.App.Model" />
    <SkipNamespace name="StreamingDoc.App.Localization" />
    <SkipNamespace name="StreamingDoc.App.Controls" />
    <SkipNamespace name="StreamingDoc.App.Audio" />
    <SkipNamespace name="StreamingDoc.App.Interop" />
    <SkipNamespace name="StreamingDoc.App.Interop.Ndi" />
  </Module>
</Obfuscator>
