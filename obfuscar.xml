<?xml version="1.0" encoding="utf-8"?>
<!--
  Configurazione Obfuscar per Nexus Streamer (WPF / .NET 9, singolo assembly).
  Rinomina SOLO i namespace "motore" (nessun riferimento per-nome da XAML/JSON/native).
  I namespace UI / modello / interop restano intatti: BAML, System.Text.Json e P/Invoke
  risolvono per NOME e si romperebbero se rinominati.

  Uso (dalla radice del repo, dopo un publish self-contained in .\publish):
    dotnet obfuscar.console obfuscar.xml
-->
<Obfuscator>
  <Var name="InPath" value="publish" />
  <Var name="OutPath" value="publish\_obf" />

  <!-- Rinomina anche l'API pubblica: e' un'app, non una libreria (nessun consumer esterno). -->
  <Var name="KeepPublicApi" value="false" />
  <Var name="HidePrivateApi" value="true" />

  <!-- HideStrings off: cifrare le stringhe puo' far scattare falsi positivi AV e rompere
       gli shader HLSL/args passati per stringa. Attivabile dopo, con test. -->
  <Var name="HideStrings" value="false" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="RegenerateDebugInfo" value="false" />

  <!-- Trova le dipendenze (Vortice, WPF framework, NAudio, AvalonDock, FFmpeg.AutoGen)
       nel folder di publish self-contained. -->
  <AssemblySearchPath path="publish" />

  <Module file="$(InPath)\Nexus Streamer.dll">
    <!-- ===== ESCLUSIONI (non rinominare) ===== -->

    <!-- UI code-behind: le classi finestra/dialogo, gli x:Name e gli handler d'evento
         sono referenziati per nome dal BAML compilato. -->
    <SkipNamespace name="StreamingDoc.App" />

    <!-- Modello di progetto: i nomi delle proprieta' SONO le chiavi JSON in project.json
         (System.Text.Json, default PascalCase). Include Scene/SceneItem bindati in XAML
         e l'enum SourceKind serializzato per nome. -->
    <SkipNamespace name="StreamingDoc.App.Model" />

    <!-- Localizzazione: LocProvider.Item[] usato nei {Binding [Key]} + AppSettings.Dto.Lang (app.json). -->
    <SkipNamespace name="StreamingDoc.App.Localization" />

    <!-- Controlli custom usati in XAML (FillHost, VuMeter, D3DPreviewHost). -->
    <SkipNamespace name="StreamingDoc.App.Controls" />

    <!-- AudioChannel: proprieta' bindate nelle strip del mixer (Name, GainDb, DisplayPeak, Muted...). -->
    <SkipNamespace name="StreamingDoc.App.Audio" />

    <!-- Interop nativo: [DllImport], struct [StructLayout] (marshaling), interfacce COM [ComImport]/[Guid]. -->
    <SkipNamespace name="StreamingDoc.App.Interop" />
    <SkipNamespace name="StreamingDoc.App.Interop.Ndi" />

    <!-- ===== OFFUSCATI (rinominati) =====
         StreamingDoc.App.Graphics   - compositor GPU, Nv12Converter, D3DImage
         StreamingDoc.App.Recording  - VideoRecorder, AudioEncoder, FfmpegLoader
         StreamingDoc.App.Output     - NdiOutput
         StreamingDoc.App.Sources    - WgcSource, WebcamSource, MediaSource, NdiSource, ...
    -->
  </Module>
</Obfuscator>
