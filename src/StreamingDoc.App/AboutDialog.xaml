<Window x:Class="StreamingDoc.App.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Streamer" Width="476" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="NexusStreamer.ico" ShowInTaskbar="False"
        MouseLeftButtonDown="OnDrag" KeyDown="OnKeyDown">

    <Window.Resources>
        <!-- X di chiusura, autonomo (non dipende da stili della finestra principale) -->
        <Style x:Key="CloseX" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33E05570"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Header}"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource B.Window}" CornerRadius="14" Margin="16"
            BorderBrush="{StaticResource B.BorderLight}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- striscia accent + chiusura -->
            <Grid Grid.Row="0">
                <Border Height="5" VerticalAlignment="Top" CornerRadius="14,14,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF2F6FED" Offset="0"/>
                            <GradientStop Color="#FF7C5CFC" Offset="0.5"/>
                            <GradientStop Color="#FFB23BD8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Button Content="✕" Style="{StaticResource CloseX}" Click="OnClose"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
            </Grid>

            <!-- contenuto -->
            <StackPanel Grid.Row="1" Margin="32,22,32,16" VerticalAlignment="Center">
                <Border Width="88" Height="88" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="#FF2F6FED"/>
                    </Border.Effect>
                    <Image Source="/Assets/NexusStreamer_256.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="Nexus Streamer" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock x:Name="VersionText" Text="Versione 1.0" FontSize="12"
                           Foreground="{StaticResource B.TextDim}" HorizontalAlignment="Center" Margin="0,3,0,0"/>

                <TextBlock Text="{Binding [AppTagline], Source={StaticResource Loc}}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" LineHeight="18"
                           Foreground="{StaticResource B.TextDim}" Margin="0,8,0,0"
                           Text="{Binding [AppDesc], Source={StaticResource Loc}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding [ChipMultiScene], Source={StaticResource Loc}}" FontSize="11"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding [ChipMixer], Source={StaticResource Loc}}" FontSize="11"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding [ChipNetwork], Source={StaticResource Loc}}" FontSize="11"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding [ChipLowLatency], Source={StaticResource Loc}}" FontSize="11"/></Border>
                </StackPanel>
            </StackPanel>

            <!-- footer -->
            <Border Grid.Row="2" Background="{StaticResource B.Header}" CornerRadius="0,0,14,14" Padding="22,12">
                <Grid>
                    <TextBlock x:Name="CopyText" Text="© 2026 Nexus Streamer" VerticalAlignment="Center"
                               Foreground="{StaticResource B.TextDim}" FontSize="11"/>
                    <Button Content="{Binding [Close], Source={StaticResource Loc}}" Width="104" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButton}" Click="OnClose" IsDefault="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
