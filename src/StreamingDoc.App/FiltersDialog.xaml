<Window x:Class="StreamingDoc.App.FiltersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtri" Height="360" Width="400" Icon="NexusStreamer.ico" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource B.Window}">
    <StackPanel Margin="18">
        <TextBlock x:Name="HeaderText" Text="Filtri sorgente" FontWeight="Bold"
                   Foreground="{StaticResource B.TextDim}" Margin="0,0,0,14"/>

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Opacità" DockPanel.Dock="Left"/>
            <TextBlock x:Name="OpacityVal" Text="100%" DockPanel.Dock="Right" Foreground="{StaticResource B.TextDim}"/>
        </DockPanel>
        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="1" ValueChanged="OnOpacity" Margin="0,0,0,16"/>

        <Border Height="1" Background="{StaticResource B.BorderLight}" Margin="0,0,0,14"/>

        <CheckBox x:Name="ChromaCheck" Content="Chroma key (green screen)" Click="OnChroma" Margin="0,0,0,12"/>

        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Colore chiave:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Verde" Width="70" Click="OnKeyGreen"/>
            <Button Content="Blu" Width="70" Click="OnKeyBlue"/>
            <Border x:Name="KeySwatch" Width="26" Height="22" Margin="10,0,0,0" CornerRadius="3"
                    BorderBrush="{StaticResource B.BorderLight}" BorderThickness="1" Background="#FF00FF00"/>
        </DockPanel>

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Somiglianza" DockPanel.Dock="Left"/>
            <TextBlock x:Name="SimVal" Text="" DockPanel.Dock="Right" Foreground="{StaticResource B.TextDim}"/>
        </DockPanel>
        <Slider x:Name="SimSlider" Minimum="0.05" Maximum="1" Value="0.4" ValueChanged="OnSim" Margin="0,0,0,12"/>

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Sfumatura" DockPanel.Dock="Left"/>
            <TextBlock x:Name="SmoothVal" Text="" DockPanel.Dock="Right" Foreground="{StaticResource B.TextDim}"/>
        </DockPanel>
        <Slider x:Name="SmoothSlider" Minimum="0" Maximum="0.5" Value="0.1" ValueChanged="OnSmooth" Margin="0,0,0,16"/>

        <Button Content="Chiudi" Width="100" HorizontalAlignment="Right" Style="{StaticResource AccentButton}" Click="OnClose"/>
    </StackPanel>
</Window>
