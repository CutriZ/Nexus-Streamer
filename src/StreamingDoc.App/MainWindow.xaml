<Window x:Class="StreamingDoc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:StreamingDoc.App.Controls"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adt="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:adk="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013"
        Title="Nexus Streamer" Height="900" Width="1560" WindowStyle="None"
        Icon="NexusStreamer.ico"
        MinWidth="1100" MinHeight="680" Background="{StaticResource B.Window}">

    <sh:WindowChrome.WindowChrome>
        <sh:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </sh:WindowChrome.WindowChrome>

    <DockPanel>

        <!-- ===== Title bar ===== -->
        <Grid DockPanel.Dock="Top" Height="42" Background="{StaticResource B.TitleBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Image Source="/Assets/NexusStreamer_32.png" Width="22" Height="22" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="ProfileText" Text="Nexus Streamer" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Pronto" Foreground="{StaticResource B.TextDim}"
                           Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="LiveBadge" Background="{StaticResource B.Btn}" CornerRadius="4" Padding="9,3" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource B.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LiveLabel" Text="OFFLINE" FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SessionText" Text="Senza titolo" VerticalAlignment="Center" Foreground="{StaticResource B.TextDim}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        sh:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBtn}" Content="—" Click="OnMinimize"/>
                <Button Style="{StaticResource TitleBtn}" Content="▢" Click="OnMaximize"/>
                <Button Style="{StaticResource TitleBtn}" Content="✕" Click="OnCloseWin"/>
            </StackPanel>
        </Grid>

        <!-- ===== Rail icone ===== -->
        <Border DockPanel.Dock="Left" Width="52" Background="{StaticResource B.Rail}">
            <DockPanel Margin="0,8">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource RailBtn}" Content="⤢" ToolTip="{Binding [ResetLayout], Source={StaticResource Loc}}" Click="OnResetLayout"/>
                    <Button Style="{StaticResource RailBtn}" Content="❔" ToolTip="{Binding [Info], Source={StaticResource Loc}}" Click="OnInfo"/>
                    <Button Style="{StaticResource RailBtn}" Content="⚙" ToolTip="{Binding [Settings], Source={StaticResource Loc}}" Click="OnSettings"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="MainMenuButton" Style="{StaticResource RailBtn}" Content="☰" ToolTip="{Binding [Menu], Source={StaticResource Loc}}" Click="OnMainMenu"/>
                    <Button Style="{StaticResource RailBtn}" Content="🎥" Foreground="{StaticResource B.Accent}" ToolTip="{Binding [StudioModeTip], Source={StaticResource Loc}}" Click="OnMenuStudio"/>
                    <Button Style="{StaticResource RailBtn}" Content="👤" ToolTip="{Binding [Profile], Source={StaticResource Loc}}" Click="OnMainMenu"/>
                    <Button Style="{StaticResource RailBtn}" Content="🎬" ToolTip="{Binding [SceneCollection], Source={StaticResource Loc}}" Click="OnMainMenu"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Docking pannelli (sposta / stacca / ridimensiona) ===== -->
        <ad:DockingManager x:Name="Docker" Background="{StaticResource B.Window}" AllowMixedOrientation="True">
            <ad:DockingManager.Theme>
                <adt:Vs2013DarkTheme/>
            </ad:DockingManager.Theme>

            <!-- Ricolora il tema VS2013 con la palette navy (le entry dirette battono il tema). -->
            <ad:DockingManager.Resources>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=Background}" Color="#FF141A24"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=NormalBackgroundBrushKey}" Color="#FF141A24"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=TabBackground}" Color="#FF0A0E15"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=PanelBorderBrush}" Color="#FF283241"/>

                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=ToolWindowCaptionActiveBackground}" Color="#FF1B2330"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=ToolWindowCaptionInactiveBackground}" Color="#FF1B2330"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=ToolWindowTabUnselectedBackground}" Color="#FF141A24"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=ToolWindowTabSelectedActiveBackground}" Color="#FF1B2330"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=ToolWindowTabSelectedInactiveBackground}" Color="#FF1B2330"/>

                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=DocumentWellTabSelectedActiveBackground}" Color="#FF1B2330"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=DocumentWellTabSelectedInactiveBackground}" Color="#FF1B2330"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=DocumentWellTabUnselectedBackground}" Color="#FF141A24"/>

                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=AutoHideTabDefaultBackground}" Color="#FF141A24"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=AutoHideTabDefaultBorder}" Color="#FF283241"/>

                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=FloatingToolWindowBackground}" Color="#FF141A24"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=FloatingDocumentWindowBackground}" Color="#FF141A24"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=FloatingToolWindowBorder}" Color="#FF283241"/>
                <SolidColorBrush x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=FloatingDocumentWindowBorder}" Color="#FF283241"/>

                <Color x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type adk:ResourceKeys}, ResourceId=ControlAccentColorKey}">#FF2F6FED</Color>
            </ad:DockingManager.Resources>

            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">

                    <!-- Colonna sinistra: Scene + Sorgenti -->
                    <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="240">
                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable Title="Scene" ContentId="scenes" CanClose="False" CanHide="False">
                                <DockPanel Margin="6">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,8">
                                        <Button Content="＋" Style="{StaticResource IconButton}" FontSize="14" Click="OnAddScene" ToolTip="{Binding [NewScene], Source={StaticResource Loc}}"/>
                                        <Button Content="–" Style="{StaticResource IconButton}" FontSize="14" Click="OnRemoveScene" ToolTip="{Binding [RemoveScene], Source={StaticResource Loc}}"/>
                                        <Button Content="{Binding [Save], Source={StaticResource Loc}}" Click="OnSaveProject" Margin="8,0,0,0"/>
                                        <Button Content="{Binding [Load], Source={StaticResource Loc}}" Click="OnLoadProject"/>
                                    </StackPanel>
                                    <ListBox x:Name="ScenesList" SelectionChanged="OnSceneSelected" MouseRightButtonUp="OnSceneRightClick"/>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable Title="Sorgenti" ContentId="sources" CanClose="False" CanHide="False">
                                <DockPanel Margin="6">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,8">
                                        <Button x:Name="AddSourceButton" Content="＋" Style="{StaticResource IconButton}" Click="OnAddSource" ToolTip="{Binding [Add], Source={StaticResource Loc}}"/>
                                        <Button Content="🗑" Style="{StaticResource IconButton}" Click="OnRemoveSource" ToolTip="{Binding [Remove], Source={StaticResource Loc}}"/>
                                        <Button Content="▲" Style="{StaticResource IconButton}" Click="OnMoveUp" ToolTip="{Binding [MoveUpFront], Source={StaticResource Loc}}"/>
                                        <Button Content="▼" Style="{StaticResource IconButton}" Click="OnMoveDown" ToolTip="{Binding [MoveDownBack], Source={StaticResource Loc}}"/>
                                    </StackPanel>
                                    <ListBox x:Name="SourcesList" SelectionChanged="OnSourceSelected" MouseRightButtonUp="OnSourceRightClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Click="OnToggleLocked" ToolTip="Blocca">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Content" Value="🔓"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                                                        <Setter Property="Content" Value="🔒"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Click="OnToggleVisible" ToolTip="Visibile" Content="👁">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Visible}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutAnchorablePaneGroup>

                    <!-- Centro: Anteprima (documento) + riga bassa Mixer/Transizioni/Proprietà -->
                    <ad:LayoutPanel Orientation="Vertical">
                        <ad:LayoutDocumentPaneGroup>
                            <ad:LayoutDocumentPane>
                                <ad:LayoutDocument Title="Anteprima" ContentId="preview" CanClose="False" CanFloat="False" CanMove="False">
                                    <DockPanel Margin="2">
                                        <ListBox x:Name="SceneTabs" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                                                 Margin="0,0,0,4" ItemContainerStyle="{StaticResource SceneTabItem}"
                                                 SelectionChanged="OnSceneTabSelected">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border DockPanel.Dock="Bottom" Background="{StaticResource B.Header}" CornerRadius="6" Padding="8,4" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SelSourceText" Text="Nessuna fonte selezionata"
                                                           VerticalAlignment="Center" Foreground="{StaticResource B.TextDim}"/>
                                                <Button Content="{Binding [PropertiesBtn], Source={StaticResource Loc}}" Click="OnPropsSelected" Margin="14,0,0,0"/>
                                                <Button Content="{Binding [Filters], Source={StaticResource Loc}}" Click="OnFiltersSelected"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FF2A2F38" CornerRadius="6" ClipToBounds="True">
                                            <Grid>
                                                <ctrl:FillHost>
                                                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                                                </ctrl:FillHost>
                                                <!-- Etichette studio (sx Preview | dx Program) -->
                                                <Grid x:Name="StudioLabels" Visibility="Collapsed" VerticalAlignment="Top"
                                                      Margin="0,8,0,0" IsHitTestVisible="False">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#E61B2330" CornerRadius="5" Padding="12,3"
                                                            HorizontalAlignment="Center" BorderBrush="{StaticResource B.BorderLight}" BorderThickness="1">
                                                        <TextBlock Text="PREVIEW" FontWeight="Bold" FontSize="11"
                                                                   Foreground="{StaticResource B.TextDim}"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#E6E05570" CornerRadius="5" Padding="12,3"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="PROGRAM" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </ad:LayoutDocument>
                            </ad:LayoutDocumentPane>
                        </ad:LayoutDocumentPaneGroup>

                        <ad:LayoutAnchorablePaneGroup Orientation="Horizontal" DockHeight="270">
                            <ad:LayoutAnchorablePane DockWidth="2*">
                                <ad:LayoutAnchorable Title="Mixer audio" ContentId="mixer" CanClose="False" CanHide="False">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                                        <ItemsControl x:Name="MixerPanel">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource B.Panel}" CornerRadius="8" Padding="10,8"
                                                            Margin="2,3" BorderBrush="{StaticResource B.BorderLight}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- intestazione: nome + lettura dB del fader -->
                                                            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                                                                <Border DockPanel.Dock="Right" Background="{StaticResource B.Header}" CornerRadius="5" Padding="7,1">
                                                                    <TextBlock Text="{Binding GainDbText}" Foreground="{StaticResource B.Accent}"
                                                                               FontSize="11" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>

                                                            <!-- VU meter -->
                                                            <ctrl:VuMeter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Horizontal="True" DbScale="True"
                                                                          Level="{Binding DisplayPeak}" MarkerDb="{Binding GainDb}" Height="11"/>

                                                            <!-- scala dB (allineata al meter e al fader) -->
                                                            <UniformGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Columns="7" Margin="0,2,0,5">
                                                                <TextBlock Text="-60" Style="{StaticResource VuTick}" HorizontalAlignment="Left"/>
                                                                <TextBlock Text="-50" Style="{StaticResource VuTick}"/>
                                                                <TextBlock Text="-40" Style="{StaticResource VuTick}"/>
                                                                <TextBlock Text="-30" Style="{StaticResource VuTick}"/>
                                                                <TextBlock Text="-20" Style="{StaticResource VuTick}"/>
                                                                <TextBlock Text="-10" Style="{StaticResource VuTick}"/>
                                                                <TextBlock Text="0" Style="{StaticResource VuTick}" HorizontalAlignment="Right"/>
                                                            </UniformGrid>

                                                            <!-- mute + fader volume (dB reale, -60..0) -->
                                                            <ToggleButton Grid.Row="3" Grid.Column="0" Style="{StaticResource MuteToggle}"
                                                                          IsChecked="{Binding Muted, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource MixerSlider}"
                                                                    Minimum="-60" Maximum="0" Value="{Binding GainDb, Mode=TwoWay}"
                                                                    VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </ad:LayoutAnchorable>
                            </ad:LayoutAnchorablePane>

                            <ad:LayoutAnchorablePane DockWidth="1*">
                                <ad:LayoutAnchorable Title="Transizioni" ContentId="transitions" CanClose="False" CanHide="False">
                                    <StackPanel Margin="10">
                                        <ComboBox x:Name="TransitionCombo" SelectedIndex="1" Margin="0,0,0,8" SelectionChanged="OnTransitionSettingsChanged">
                                            <ComboBoxItem Content="{Binding [TransCut], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Content="{Binding [TransFade], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Content="{Binding [TransSlide], Source={StaticResource Loc}}"/>
                                        </ComboBox>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="ms" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                            <TextBox x:Name="TransitionMs" Text="350" TextChanged="OnTransitionSettingsChanged"/>
                                        </DockPanel>
                                        <Button x:Name="TransitionButton" Content="{Binding [DoTransition], Source={StaticResource Loc}}" Click="OnTransition" IsEnabled="False"/>
                                        <Button Content="{Binding [StudioMode], Source={StaticResource Loc}}" Click="OnMenuStudio" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </ad:LayoutAnchorable>
                            </ad:LayoutAnchorablePane>

                            <ad:LayoutAnchorablePane DockWidth="1.3*">
                                <ad:LayoutAnchorable Title="Proprietà sorgente" ContentId="props" CanClose="False" CanHide="False">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Name], Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="{StaticResource B.TextDim}"/>
                                        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="PropName" IsReadOnly="True" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Opacity], Source={StaticResource Loc}}" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="{StaticResource B.TextDim}"/>
                                        <Slider   Grid.Row="1" Grid.Column="1" x:Name="PropOpacity" Minimum="0" Maximum="1" Value="1" Margin="0,0,0,8" ValueChanged="OnPropOpacity"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <CheckBox x:Name="PropVisible" Content="{Binding [Visible], Source={StaticResource Loc}}" Click="OnPropVisible" Margin="0,0,16,0"/>
                                            <CheckBox x:Name="PropLocked" Content="{Binding [Locked], Source={StaticResource Loc}}" Click="OnPropLocked"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="{Binding [PropertiesDots], Source={StaticResource Loc}}" Click="OnPropsSelected" Margin="0,0,6,0"/>
                                            <Button Content="{Binding [FiltersDots], Source={StaticResource Loc}}" Click="OnFiltersSelected"/>
                                        </StackPanel>
                                    </Grid>
                                </ad:LayoutAnchorable>
                            </ad:LayoutAnchorablePane>
                        </ad:LayoutAnchorablePaneGroup>
                    </ad:LayoutPanel>

                    <!-- Colonna destra: Stato + Controlli -->
                    <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="250">
                        <ad:LayoutAnchorablePane DockHeight="200">
                            <ad:LayoutAnchorable Title="Stato" ContentId="status" CanClose="False" CanHide="False">
                                <StackPanel Margin="14,12">
                                    <DockPanel Margin="0,3">
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource B.Live}" VerticalAlignment="Center"/>
                                        <TextBlock Text="LIVE" Margin="8,0,0,0" Foreground="{StaticResource B.TextDim}"/>
                                        <TextBlock x:Name="StLive" Text="00:00:00" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource B.Rec}" VerticalAlignment="Center"/>
                                        <TextBlock Text="REC" Margin="8,0,0,0" Foreground="{StaticResource B.TextDim}"/>
                                        <TextBlock x:Name="StRec" Text="00:00:00" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="🎞" VerticalAlignment="Center"/>
                                        <TextBlock Text="FPS" Margin="8,0,0,0" Foreground="{StaticResource B.TextDim}"/>
                                        <TextBlock x:Name="StFps" Text="0" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="⚙" VerticalAlignment="Center"/>
                                        <TextBlock Text="CPU" Margin="8,0,0,0" Foreground="{StaticResource B.TextDim}"/>
                                        <TextBlock x:Name="StCpu" Text="0%" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="📶" VerticalAlignment="Center"/>
                                        <TextBlock Text="kb/s" Margin="8,0,0,0" Foreground="{StaticResource B.TextDim}"/>
                                        <TextBlock x:Name="StKbs" Text="0" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable Title="Controlli" ContentId="controls" CanClose="False" CanHide="False">
                                <StackPanel Margin="12,12">
                                    <Button x:Name="GoLiveButton" Content="Avvia Streaming" Style="{StaticResource CtrlButton}" Click="OnToggleStream"/>
                                    <Button x:Name="RecordButton" Content="Avvia Registrazione" Style="{StaticResource CtrlButton}" Click="OnToggleRecord"/>
                                    <Button x:Name="ScteLogButton" Content="Log SCTE-35" Style="{StaticResource CtrlButton}" Click="OnScteLog" IsEnabled="False" ToolTip="Attivo solo con streaming SRT + SCTE-35 abilitato"/>
                                    <Button x:Name="VirtualCamButton" Content="Avvia Camera Virtuale" Style="{StaticResource CtrlButton}" Click="OnVirtualCam"/>
                                    <Button Content="{Binding [Settings], Source={StaticResource Loc}}" Style="{StaticResource CtrlButton}" Click="OnSettings"/>
                                    <Button Content="{Binding [Exit], Source={StaticResource Loc}}" Style="{StaticResource CtrlButton}" Click="OnCloseWin"/>
                                    <CheckBox x:Name="AudioCheck" Content="{Binding [CaptureDesktopAudio], Source={StaticResource Loc}}" IsChecked="True" Margin="2,8,0,0"/>
                                    <ToggleButton x:Name="StudioCheck" Visibility="Collapsed" Click="OnStudioToggle"/>
                                </StackPanel>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutAnchorablePaneGroup>

                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
