<Window x:Class="StreamingDoc.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [Settings], Source={StaticResource Loc}}" Height="620" Width="820" Icon="NexusStreamer.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource B.Window}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav -->
        <ListBox x:Name="Nav" Grid.Row="0" Grid.Column="0" Background="{StaticResource B.Panel}"
                 BorderBrush="{StaticResource B.BorderDark}" BorderThickness="1" Margin="0,0,8,0"
                 SelectionChanged="OnNavChanged">
            <ListBoxItem Content="{Binding [GeneralTab], Source={StaticResource Loc}}"/>
            <ListBoxItem Content="Video"/>
            <ListBoxItem Content="{Binding [Output], Source={StaticResource Loc}}"/>
            <ListBoxItem Content="Stream"/>
            <ListBoxItem Content="{Binding [Audio], Source={StaticResource Loc}}"/>
        </ListBox>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Dock}" Margin="0">
            <Grid Margin="16">
                <!-- GENERALE -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Text="{Binding [GeneralTab], Source={StaticResource Loc}}" FontWeight="Bold" Foreground="{StaticResource B.TextDim}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding [Language], Source={StaticResource Loc}}"/>
                    <ComboBox x:Name="LangCombo" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left"
                              SelectedValuePath="Code" SelectionChanged="OnLanguageChanged"/>
                </StackPanel>

                <!-- VIDEO -->
                <StackPanel x:Name="PanelVideo" Visibility="Collapsed">
                    <TextBlock Text="VIDEO" FontWeight="Bold" Foreground="{StaticResource B.TextDim}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding [CanvasRes], Source={StaticResource Loc}}"/>
                    <ComboBox x:Name="CanvasCombo" IsEditable="True" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem>1920x1080</ComboBoxItem>
                        <ComboBoxItem>1280x720</ComboBoxItem>
                        <ComboBoxItem>2560x1440</ComboBoxItem>
                        <ComboBoxItem>3840x2160</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="FPS"/>
                    <ComboBox x:Name="FpsCombo" IsEditable="True" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left">
                        <ComboBoxItem>30</ComboBoxItem>
                        <ComboBoxItem>60</ComboBoxItem>
                        <ComboBoxItem>24</ComboBoxItem>
                        <ComboBoxItem>48</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="{Binding [ResFpsNote], Source={StaticResource Loc}}"
                               Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- USCITA -->
                <StackPanel x:Name="PanelOutput" Visibility="Collapsed">
                    <TextBlock Text="{Binding [Output], Source={StaticResource Loc}}" FontWeight="Bold" Foreground="{StaticResource B.TextDim}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding [RecFolder], Source={StaticResource Loc}}"/>
                    <DockPanel Margin="0,4,0,12">
                        <Button Content="{Binding [Browse], Source={StaticResource Loc}}" DockPanel.Dock="Right" Width="80" Margin="6,0,0,0" Click="OnBrowseFolder"/>
                        <TextBox x:Name="FolderBox"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding [RecFormat], Source={StaticResource Loc}}"/>
                            <ComboBox x:Name="FormatCombo" Margin="0,4,0,12">
                                <ComboBoxItem>mp4</ComboBoxItem>
                                <ComboBoxItem>mkv</ComboBoxItem>
                                <ComboBoxItem>flv</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Encoder], Source={StaticResource Loc}}"/>
                            <ComboBox x:Name="EncoderCombo" Margin="0,4,0,12">
                                <ComboBoxItem Tag="auto" Content="{Binding [EncoderAuto], Source={StaticResource Loc}}"/>
                                <ComboBoxItem Tag="h264_nvenc">NVIDIA NVENC (H.264)</ComboBoxItem>
                                <ComboBoxItem Tag="libx264">x264 (software)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding [RecBitrate], Source={StaticResource Loc}}"/>
                            <TextBox x:Name="RecBitrateBox" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [StreamBitrate], Source={StaticResource Loc}}"/>
                            <TextBox x:Name="StreamBitrateBox" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- STREAM -->
                <StackPanel x:Name="PanelStream" Visibility="Collapsed">
                    <TextBlock Text="STREAM" FontWeight="Bold" Foreground="{StaticResource B.TextDim}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding [Protocol], Source={StaticResource Loc}}"/>
                    <ComboBox x:Name="ProtoCombo" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left"
                              SelectionChanged="OnProtoChanged">
                        <ComboBoxItem Tag="none" Content="{Binding [ProtoNone], Source={StaticResource Loc}}"/>
                        <ComboBoxItem Tag="rtmp">RTMP</ComboBoxItem>
                        <ComboBoxItem Tag="srt">SRT</ComboBoxItem>
                    </ComboBox>

                    <!-- RTMP -->
                    <StackPanel x:Name="RtmpGroup">
                        <TextBlock Text="{Binding [Server], Source={StaticResource Loc}}"/>
                        <TextBox x:Name="ServerBox" Margin="0,4,0,12"/>

                        <TextBlock Text="{Binding [StreamKey], Source={StaticResource Loc}}"/>
                        <DockPanel Margin="0,4,0,12">
                            <Button x:Name="KeyShowBtn" DockPanel.Dock="Right" Width="92" Margin="6,0,0,0" Click="OnToggleKey"/>
                            <Grid>
                                <PasswordBox x:Name="KeyPwd"/>
                                <TextBox x:Name="KeyTxt" Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>

                        <CheckBox x:Name="UseAuth" Content="{Binding [UseAuth], Source={StaticResource Loc}}"
                                  Margin="0,8,0,10" Click="OnToggleAuth"/>

                        <TextBlock Text="{Binding [Username], Source={StaticResource Loc}}"/>
                        <TextBox x:Name="UserBox" Margin="0,4,0,12"/>

                        <TextBlock Text="{Binding [Password], Source={StaticResource Loc}}"/>
                        <DockPanel Margin="0,4,0,12">
                            <Button x:Name="PassShowBtn" DockPanel.Dock="Right" Width="92" Margin="6,0,0,0" Click="OnTogglePass"/>
                            <Grid>
                                <PasswordBox x:Name="PassPwd"/>
                                <TextBox x:Name="PassTxt" Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>

                        <TextBlock Text="{Binding [StreamExample], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- SRT -->
                    <StackPanel x:Name="SrtGroup" Visibility="Collapsed">
                        <TextBlock Text="{Binding [SrtMode], Source={StaticResource Loc}}"/>
                        <ComboBox x:Name="SrtModeCombo" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Tag="caller" Content="{Binding [SrtCaller], Source={StaticResource Loc}}"/>
                            <ComboBoxItem Tag="listener" Content="{Binding [SrtListener], Source={StaticResource Loc}}"/>
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{Binding [SrtHost], Source={StaticResource Loc}}"/>
                                <TextBox x:Name="SrtHostBox" Margin="0,4,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [SrtPort], Source={StaticResource Loc}}"/>
                                <TextBox x:Name="SrtPortBox" Margin="0,4,0,12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding [SrtLatency], Source={StaticResource Loc}}"/>
                        <TextBox x:Name="SrtLatencyBox" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left"/>

                        <TextBlock Text="{Binding [SrtNote], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap"/>

                        <TextBlock Text="URL SRT completo (opzionale)" Margin="0,12,0,0"/>
                        <TextBox x:Name="SrtUrlBox" Margin="0,4,0,4" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="Se compilato, l'app usa questo URL tale e quale (streamid, transtype, token) e ignora host/porta/modo qui sopra."
                                   Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap"/>

                        <Border BorderBrush="{StaticResource B.BorderDark}" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
                        <CheckBox x:Name="ScteEnable" Content="{Binding [ScteEnable], Source={StaticResource Loc}}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding [SctePlayoutFile], Source={StaticResource Loc}}"/>
                        <DockPanel Margin="0,4,0,6">
                            <Button Content="{Binding [Browse], Source={StaticResource Loc}}" DockPanel.Dock="Right" Width="80" Margin="6,0,0,0" Click="OnBrowseScte"/>
                            <TextBox x:Name="ScteFileBox"/>
                        </DockPanel>
                        <TextBlock Text="{Binding [ScteNote], Source={StaticResource Loc}}"
                                   Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="{Binding [StreamBitrateNote], Source={StaticResource Loc}}"
                               Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- AUDIO -->
                <StackPanel x:Name="PanelAudio" Visibility="Collapsed">
                    <TextBlock Text="AUDIO" FontWeight="Bold" Foreground="{StaticResource B.TextDim}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding [SampleRate], Source={StaticResource Loc}}"/>
                    <ComboBox x:Name="SampleRateCombo" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left">
                        <ComboBoxItem>48000</ComboBoxItem>
                        <ComboBoxItem>44100</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="{Binding [AudioNote], Source={StaticResource Loc}}"
                               Foreground="{StaticResource B.TextDim}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding [Cancel], Source={StaticResource Loc}}" Width="100" Height="28" Click="OnCancel"/>
            <Button Content="{Binding [OK], Source={StaticResource Loc}}" Width="100" Height="28" Style="{StaticResource AccentButton}" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
